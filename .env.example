APP_NAME=one-backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

# Fill these with your Supabase project credentials.
# SUPABASE_KEY must be the service_role key: the tables have RLS without policies.
SUPABASE_URL=
SUPABASE_KEY=

# Token issued to proxy-server, sent as Authorization: Bearer. Empty: no request counts as the proxy.
GATEWAY_TOKEN=
